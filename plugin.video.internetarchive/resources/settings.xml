<?xml version="1.0" encoding="UTF-8"?>
<settings version="1">
  <section id="plugin.video.internetarchive">
    <category id="accounts" label="Accounts">
      <group id="realdebrid">
        <setting id="rd_token" type="string" label="Real-Debrid API token (your own account)">
          <default></default>
          <control type="edit" format="string">
            <allowempty>true</allowempty>
          </control>
        </setting>
      </group>
    </category>
    <category id="browsing" label="Browsing">
      <group id="sorting">
        <setting id="sort_order" type="string" label="Sort browse and search results by">
          <default>relevance</default>
          <options>
            <option>relevance</option>
            <option>downloads</option>
            <option>date</option>
            <option>title</option>
          </options>
          <control type="list" format="string"/>
        </setting>
      </group>
    </category>
  </section>
</settings>
