<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.internetarchive" name="Internet Archive — Kodi Addon" version="1.0.0" provider-name="Scout">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary>Internet Archive — Kodi Addon</summary>
    <description>Kodi addon for browsing and playing Internet Archive content, with Real-Debrid support for resolved playback. Built for Kodi 21 Omega.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
